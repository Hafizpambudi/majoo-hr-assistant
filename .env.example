# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# optional fallback
OPENROUTER_API_KEY=

# Embeddings
# Numbered keys form an ordered pool: ingest rotates to the next one when a key
# hits its daily quota. GEMINI_API_KEY still works as a single-key fallback.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
# 1536 keeps the column indexable by pgvector HNSW (2000 dim hard limit)
EMBEDDING_DIM=1536
# Gemini free tier meters content items per minute, not requests
EMBEDDING_BATCH_SIZE=90
EMBEDDING_RPM_LIMIT=95

# Vector store
DATABASE_URL=postgresql://majo:majo@localhost:5433/majo_hr

# Retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
# First-party only by default: the third-party handbook contains other
# countries' HR policy. Set to empty to search the whole index.
SOURCE_SCOPE=majo-hr
SIMILARITY_THRESHOLD=0.62

# Harness
MAX_STEPS=4
